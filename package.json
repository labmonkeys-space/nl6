    "fast-uri": "^3.1.2",
    "js-yaml": "^4.3.0",
    "brace-expansion": "^1.1.16",
    "uuid": "^11.1.1",
    "joi": "^17.13.4",
    "http-proxy-middleware": "^2.0.10",
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4"
  }
