{
  "comment": "Shape of a gnmic ONCE subscription against vJunos-router 25.4R1.12 (PROTO). Values removed; paths are absolute with wildcard keys; see context/gnmi-vendor-sources.md. Extended for nl6#772: the temperature record (avg, min, max, alarm-status, alarm-threshold, interval, min-time, max-time) and firmware-version come from the MX10004 hardware reference set, and temperature kinds are decimal (Decimal64 precision 1) as the hardware sends them; vJunos 25.4R1.12 sent instant as uint.",
  "subtree": "component-temp",
  "prefixes": [
    "openconfig:/components/component[name=*]"
  ],
  "notifications": 2,
  "extension": "juniper-header",
  "leaves": [
    {
      "path": "/components/component[name=*]/state/temperature/alarm-status",
      "kind": "bool"
    },
    {
      "path": "/components/component[name=*]/state/temperature/alarm-threshold",
      "kind": "uint"
    },
    {
      "path": "/components/component[name=*]/state/temperature/avg",
      "kind": "decimal"
    },
    {
      "path": "/components/component[name=*]/state/temperature/instant",
      "kind": "decimal"
    },
    {
      "path": "/components/component[name=*]/state/temperature/interval",
      "kind": "uint"
    },
    {
      "path": "/components/component[name=*]/state/temperature/max",
      "kind": "decimal"
    },
    {
      "path": "/components/component[name=*]/state/temperature/max-time",
      "kind": "uint"
    },
    {
      "path": "/components/component[name=*]/state/temperature/min",
      "kind": "decimal"
    },
    {
      "path": "/components/component[name=*]/state/temperature/min-time",
      "kind": "uint"
    }
  ]
}
