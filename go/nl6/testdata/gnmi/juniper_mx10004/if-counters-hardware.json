{
  "comment": "Shape of the MX10004 hardware reference set for the interface counters subscription (nl6#775); hand-written from the issue, an authoring record, not an observation. name and parent-ae-name are marked always: the sensor sends them with every counters notification. absent lists the eleven out-queue leaves the vJunos capture (if-state.json) showed and the hardware does not send.",
  "subtree": "if-counters",
  "prefixes": [
    "openconfig:/interfaces/interface[name=*]",
    "openconfig:/interfaces/interface[name=*]/state/counters/out-queue[queue-number=*]"
  ],
  "notifications": 0,
  "extension": "juniper-header",
  "leaves": [
    {
      "path": "/interfaces/interface[name=*]/name",
      "kind": "string",
      "always": true
    },
    {
      "path": "/interfaces/interface[name=*]/state/parent-ae-name",
      "kind": "string",
      "always": true
    },
    {
      "path": "/interfaces/interface[name=*]/state/counters/out-queue[queue-number=*]/queue-number",
      "kind": "uint"
    }
  ],
  "absent": [
    "/interfaces/interface[name=*]/state/counters/out-queue[queue-number=*]/allocated-buffer-size",
    "/interfaces/interface[name=*]/state/counters/out-queue[queue-number=*]/avg-buffer-occupancy",
    "/interfaces/interface[name=*]/state/counters/out-queue[queue-number=*]/bytes",
    "/interfaces/interface[name=*]/state/counters/out-queue[queue-number=*]/cur-buffer-occupancy",
    "/interfaces/interface[name=*]/state/counters/out-queue[queue-number=*]/peak-buffer-occupancy",
    "/interfaces/interface[name=*]/state/counters/out-queue[queue-number=*]/pkts",
    "/interfaces/interface[name=*]/state/counters/out-queue[queue-number=*]/red-drop-bytes",
    "/interfaces/interface[name=*]/state/counters/out-queue[queue-number=*]/red-drop-pkts",
    "/interfaces/interface[name=*]/state/counters/out-queue[queue-number=*]/rl-drop-bytes",
    "/interfaces/interface[name=*]/state/counters/out-queue[queue-number=*]/rl-drop-pkts",
    "/interfaces/interface[name=*]/state/counters/out-queue[queue-number=*]/tail-drop-pkts"
  ]
}
