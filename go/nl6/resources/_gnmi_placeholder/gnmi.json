{
  "comment": "Placeholder: exists only so the go:embed glob matches until a real catalogue ships. Task 8 deletes it.",
  "vendor": "testvendor",
  "notification": {
    "origin": "openconfig",
    "native_origin": "testvendor",
    "prefix": "list-entry",
    "encodings": ["PROTO", "JSON"],
    "extension": "none"
  },
  "models": [
    {"name": "openconfig-interfaces", "organization": "OpenConfig working group", "version": "3.11.1"}
  ],
  "components": [
    {"name": "Chassis", "type": "CHASSIS", "parent": "", "part_no": "TEST-CHASSIS", "description": "Test chassis", "serial_no": "SN000001", "temperature": false},
    {"name": "FPC0", "type": "LINECARD", "parent": "Chassis", "part_no": "TEST-LC", "description": "Test line card", "serial_no": "SN000002", "temperature": true}
  ],
  "neighbors": [
    {"address": "203.0.113.1", "peer_as": 64496, "local_as": 64500, "state": "ESTABLISHED"}
  ],
  "subtrees": [
    {
      "path": "/interfaces/interface[name=*]",
      "origin": "openconfig",
      "keys": [{"source": "interfaces"}],
      "leaves": [
        {"name": "state/counters/in-octets", "type": "uint64", "gen": "ifcounter:ifHCInOctets"},
        {"name": "state/oper-status", "type": "enumeration", "enum": ["UP", "DOWN"], "gen": "ifstate:oper"}
      ]
    },
    {
      "path": "/components/component[name=*]",
      "origin": "openconfig",
      "keys": [{"source": "components"}],
      "leaves": [
        {"name": "state/serial-no", "type": "string", "gen": "inventory:serial_no"}
      ]
    },
    {
      "path": "/components/component[name=*]/state/temperature",
      "origin": "openconfig",
      "keys": [{"source": "components", "filter": "temperature"}],
      "leaves": [
        {"name": "instant", "type": "uint64", "gen": "sine:40,5,600"}
      ]
    }
  ]
}
