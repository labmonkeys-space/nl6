// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // TypeScript 7 removed baseUrl; null clears the one the base config sets.
    // Without baseUrl, paths resolve relative to the file that declares them,
    // so @site/* is declared here to anchor it at the repo root.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    },
    "strict": true
  },
  "include": ["src", "docusaurus.config.ts", "sidebars.ts"],
  "exclude": [".docusaurus", "build"]
}
