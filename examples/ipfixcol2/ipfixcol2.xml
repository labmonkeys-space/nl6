<?xml version="1.0" encoding="UTF-8"?>
<!--
  IPFIXcol2 startup config for `make test-interop-ipfix`.

  UDP input on the loopback collector port nl6's test exporter targets, and a
  JSON output that SENDS newline-delimited records over TCP to the Go test's
  listener. Options records are INCLUDED so the RFC 6759 application table
  (template 259) reaches the test, and unknown elements are INCLUDED so an
  unresolved PEN 9 element shows up as `en9:idNNNN` (the failure signal)
  rather than vanishing. octetArrayAsUint keeps applicationId (octetArray 4)
  as an integer. nonPrintableChar is ON so that a non-printable byte inside a
  string-typed element is ESCAPED (\u00XX) instead of DROPPED: libfds types
  PEN 9 IEs 12235 and 9357 as string, the host value starts with Cisco's
  six-byte prefix 03 00 00 50 34 02 (nl6#679) and the URI statistics value
  ends in a NUL and a two-byte count, and with the flag off (measured
  2026-09-21) the collector rendered them as "P4www.example.com" and
  "/index.html", four of the six prefix bytes and the whole hit count gone.
  The earlier comment here said the flag was off SO THAT the test could see
  those bytes; the flag's sense is the reverse, and the test never saw them.
-->
<ipfixcol2>
    <inputPlugins>
        <input>
            <name>nl6 UDP input</name>
            <plugin>udp</plugin>
            <params>
                <localPort>4739</localPort>
                <localIPAddress>127.0.0.1</localIPAddress>
            </params>
        </input>
    </inputPlugins>
    <outputPlugins>
        <output>
            <name>NDJSON to the Go test</name>
            <plugin>json</plugin>
            <params>
                <tcpFlags>raw</tcpFlags>
                <timestamp>unix</timestamp>
                <protocol>raw</protocol>
                <ignoreUnknown>false</ignoreUnknown>
                <ignoreOptions>false</ignoreOptions>
                <nonPrintableChar>true</nonPrintableChar>
                <octetArrayAsUint>true</octetArrayAsUint>
                <numericNames>false</numericNames>
                <splitBiflow>false</splitBiflow>
                <detailedInfo>true</detailedInfo>
                <templateInfo>false</templateInfo>
                <outputs>
                    <send>
                        <name>Go test listener</name>
                        <ip>127.0.0.1</ip>
                        <port>14739</port>
                        <protocol>tcp</protocol>
                        <blocking>yes</blocking>
                    </send>
                </outputs>
            </params>
        </output>
    </outputPlugins>
</ipfixcol2>
