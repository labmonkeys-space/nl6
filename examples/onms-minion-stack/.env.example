#
# Copy to .env and fill in the two required values, then `docker compose up`.
#   cp .env.example .env

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# How the Minion reaches your existing OpenNMS core's Kafka (sink + rpc IPC).
# Comma-separated host:port list, e.g. kafka1.example.com:9092,kafka2.example.com:9092
KAFKA_BOOTSTRAP=

# Your existing OpenNMS core's REST endpoint (scheme + host + port + context path)
# and credentials — used to import the 14 fabric nodes at location nl6-Lab.
OPENNMS_BASE_URL=
OPENNMS_USER=admin
OPENNMS_PASS=admin

# ── MINION IDENTITY (override if you like) ──────────────────────────────────────

MINION_ID=nl6-Minion-01
MINION_LOCATION=nl6-Lab

# ── IMAGES ──────────────────────────────────────────────────────────────────────

# Pin the Minion image to the SAME major version as your OpenNMS core
# (e.g. opennms/minion:33.1.6). "latest" is for quick trials only and may
# mismatch your core's IPC/feature versions.
MINION_IMAGE=opennms/minion:latest

# nl6 simulator image (override to pin a release, e.g. ghcr.io/labmonkeys-space/nl6:v0.11.0).
NL6_IMAGE=ghcr.io/labmonkeys-space/nl6:latest

# ── OPTIONAL: secured Kafka (SASL_SSL) ──────────────────────────────────────────
# Leave blank for PLAINTEXT. To enable, set these AND uncomment the matching
# KAFKA_IPC_* lines in compose.yml (minion service).
#KAFKA_SECURITY_PROTOCOL=SASL_SSL
#KAFKA_SASL_MECHANISM=SCRAM-SHA-512
#KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="USER" password="PASS";
